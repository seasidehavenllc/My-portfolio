require "base64"
require "tmpdir"

# Builds the iPhone app and uploads it to TestFlight.
# GitHub runs this after every merge to main (.github/workflows/ios-testflight.yml).
# The secrets it reads are listed in app/TESTFLIGHT.md.

default_platform(:ios)

APP_ID  = "com.seasidehaven.sitebuilder"
PROJECT = "ios/App/App.xcodeproj"

platform :ios do
  desc "Build the app and upload it to TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_P8"),
      in_house: false
    )

    # A throwaway keychain on the build machine, holding the distribution certificate.
    setup_ci
    cert_path = File.join(Dir.tmpdir, "distribution.p12")
    File.binwrite(cert_path, Base64.decode64(ENV.fetch("DIST_CERT_P12_BASE64")))
    import_certificate(
      certificate_path: cert_path,
      certificate_password: ENV.fetch("DIST_CERT_PASSWORD"),
      keychain_name: "fastlane_tmp_keychain",
      keychain_password: ""
    )

    # Downloads (or creates, the first time) the App Store profile for that certificate.
    get_provisioning_profile(api_key: api_key, app_identifier: APP_ID)
    profile_name = lane_context[SharedValues::SIGH_NAME]

    update_code_signing_settings(
      path: PROJECT,
      targets: ["App"],
      use_automatic_signing: false,
      team_id: ENV.fetch("APPLE_TEAM_ID"),
      code_sign_identity: "Apple Distribution",
      profile_name: profile_name,
      bundle_identifier: APP_ID
    )

    # Build numbers count up 1, 2, 3: one higher than the highest normal build number
    # already in App Store Connect, across every version and including builds that are
    # still processing. The few date-style numbers (like 2611202316) used on 20 Nov 2026
    # are skipped, so counting carries on from the old hand-made builds.
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.from(hash: api_key)
    app = Spaceship::ConnectAPI::App.find(APP_ID)
    numbers = Spaceship::ConnectAPI::Build.all(app_id: app.id, sort: "-uploadedDate", limit: 200)
                .map { |b| b.version.to_s.split(".").first.to_i }
                .select { |n| n < 1_000_000 }
    next_number = (numbers.max || 0) + 1
    UI.message("Highest build number so far: #{numbers.max.inspect}. This build: #{next_number}")
    increment_build_number(xcodeproj: PROJECT, build_number: next_number.to_s)

    build_app(
      project: PROJECT,
      scheme: "App",
      configuration: "Release",
      export_method: "app-store",
      export_options: { provisioningProfiles: { APP_ID => profile_name } },
      output_directory: "build",
      clean: true
    )

    upload_to_testflight(api_key: api_key, skip_waiting_for_build_processing: true)
  end
end
